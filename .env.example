APP_NAME="Music Harvester"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8085
APP_PORT=8085

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=music_harvester
DB_USERNAME=music
DB_PASSWORD=music

# Local PHPUnit uses SQLite :memory: via phpunit.xml (no Postgres required for tests).

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:4200,localhost:8085,127.0.0.1,127.0.0.1:8000

ADMIN_EMAIL=admin@music-harvester.local
ADMIN_PASSWORD=admin
ADMIN_USERNAME=admin
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Harvester

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Music Harvester
MUSIC_PATH=/music
COOKIES_PATH=/cookies/cookies.txt
YOUTUBE_MUSIC_COOKIES_PATH=/cookies/youtube/cookies.txt
DEEZER_ARL=
DEEZER_MODE=native
ENABLED_PROVIDERS=youtube_music,deezer
MUSIC_DEFAULT_FORMAT=mp3_320
MUSIC_MAX_CONCURRENCY=1
MUSIC_DEFAULT_SYNC_INTERVAL_MINUTES=5
STREAMRIP_BIN=rip
METADATA_ENRICH_ENABLED=true
METADATA_EMBED_COVER=true
METADATA_EMBED_LYRICS=true

VITE_APP_NAME="${APP_NAME}"
